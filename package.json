{
  "name": "slack-simulator",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"yarn dev:server\" \"yarn dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "yarn build:client && yarn build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit",
    "docs:dev": "cd docs && eleventy --serve",
    "docs:build": "cd docs && eleventy",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage --run"
  },
  "dependencies": {
    "@dicebear/collection": "^9.2.2",
    "@dicebear/core": "^9.2.2",
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^7.0.4",
    "@fastify/websocket": "^8.3.1",
    "@tanstack/react-query": "^5.51.1",
    "better-sqlite3": "^11.1.2",
    "fastify": "^4.28.1",
    "pino": "^9.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0",
    "yaml": "^2.4.5",
    "zod": "^3.23.8",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "4.1.8",
    "@vitest/ui": "^4.1.8",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "highlight.js": "^11.9.0",
    "jsdom": "^29.1.1",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "postcss": "^8.4.39",
    "prettier": "^3.8.4",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.7",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vitest": "^4.1.8"
  }
}
