{
  "$schema": "./apps.schema.json",
  "apps": [
    {
      "id": "A001",
      "botUserId": "B001",
      "botUserName": "demo",
      "name": "Demo Bot",
      "description": "Responds to a 'hello' with a reply in channel, responds to a 'ping' with a reply in thread, and responds to a 'ghost' message with an ephemeral reply in channel visible only to the sender. Send '/echo hey' to echo your message back to the channel. Also responds to 'app_mention' events.",
      "socketModeEnabled": true,
      "requestUrl": "http://localhost:4002/slack/events",
      "botToken": "xoxb-slacksim-demo",
      "appToken": "xapp-slacksim-demo",
      "signingSecret": "slacksim-secret-demo",
      "subscribedEvents": ["message", "app_mention"],
      "slashCommands": [
        {
          "command": "/echo",
          "description": "Echo your message back to the channel",
          "usage": "[text]"
        }
      ]
    },
    {
      "id": "A002",
      "botUserId": "B002",
      "botUserName": "http",
      "name": "Http Bot",
      "description": "Responds to a 'hello' and 'app_mention' events via HTTP",
      "socketModeEnabled": false,
      "requestUrl": "http://localhost:4003/slack/events",
      "botToken": "xoxb-slacksim-http",
      "appToken": "xapp-slacksim-http",
      "signingSecret": "slacksim-secret-http",
      "subscribedEvents": ["message", "app_mention"],
      "slashCommands": []
    },
    {
      "id": "A003",
      "botUserId": "B003",
      "botUserName": "vote",
      "name": "Vote Bot",
      "description": "Create a simple poll triggered by a slash command",
      "avatarUrl": "/config/avatars/vote.png",
      "socketModeEnabled": true,
      "botToken": "xoxb-slacksim-vote",
      "appToken": "xapp-slacksim-vote",
      "signingSecret": "slacksim-secret-vote",
      "subscribedEvents": [],
      "slashCommands": [
        {
          "command": "/vote",
          "description": "Create a poll",
          "usage": "[\"question\"] [\"option1\"] [\"option2\"] ..."
        }
      ]
    },
    {
      "id": "A004",
      "botUserId": "B004",
      "botUserName": "gif",
